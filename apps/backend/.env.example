HOST=127.0.0.1
PORT=3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-local-password
MYSQL_DATABASE=classroom_toolkit
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=false
# 老库首次增加 teacher_id 时，指定历史业务数据的归属账号。
LEGACY_DATA_OWNER_USERNAME=

# 首次启动创建管理员（已有管理员时不覆盖）。初始化后移除密码配置。
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
# 生产 HTTPS 为 true；仅本机 HTTP 联调可设 false。
ADMIN_COOKIE_SECURE=true
# 历史教师 DATETIME 字段的 UTC 偏移；空值沿用后端运行环境偏移。
TEACHER_DATA_UTC_OFFSET=

# 学期报告：默认直接上传 PDF 到 Kimi 云端解析。
SEMESTER_REPORT_PARSER_URL=http://127.0.0.1:18000/parse
SEMESTER_REPORT_PARSER_API_KEY=
SEMESTER_REPORT_PARSER_PROVIDER=kimi
# Kimi 文件解析仅需服务端 API key，无需 Poppler 或本地 OCR。
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
# auto: 无 AI 配置时使用模板；template: 始终本地模板；ai: 必须配置模型服务。
REPORT_GENERATION_MODE=auto
REPORT_AI_BASE_URL=
REPORT_AI_API_KEY=
REPORT_AI_MODEL=
REPORT_PUBLIC_BASE_URL=http://localhost:3001
REPORT_SHARE_ENCRYPTION_KEY=
