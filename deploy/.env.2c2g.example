# Run deploy/2c2g-deploy.sh init to generate passwords and the report key.
LOGIN_PROXY_SECRET=CHANGE_ME_LOGIN_PROXY_SECRET
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_USER=classroom_app
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
LEGACY_DATA_OWNER_USERNAME=
TEACHER_DATA_UTC_OFFSET=
BACKEND_PORT=3000
WEB_PORT=3001
ADMIN_PORT=8080
REPORT_PUBLIC_BASE_URL=https://classroom.example.com
# Kimi cloud PDF extraction: fill the real API key on the server, never in the browser.
SEMESTER_REPORT_PARSER_PROVIDER=kimi
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
# Only required when provider=docling (independent /parse adapter).
SEMESTER_REPORT_PARSER_URL=
SEMESTER_REPORT_PARSER_API_KEY=
REPORT_SHARE_ENCRYPTION_KEY=CHANGE_ME_REPORT_KEY
# 用 openssl rand -base64 32 生成；用于加密 Admin 保存的报告 AI Key。
REPORT_AI_SETTINGS_ENCRYPTION_KEY=
