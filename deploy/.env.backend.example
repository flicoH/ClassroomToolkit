BACKEND_PORT=3000
MYSQL_ROOT_PASSWORD=Hqjllwm520@gmail.com
MYSQL_USER=classroom_app
MYSQL_PASSWORD=Hqjllwm520@gmail.com
LEGACY_DATA_OWNER_USERNAME=

# 首次启动创建管理员（已有管理员时不覆盖）。初始化后移除密码配置。
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
# 生产 HTTPS 为 true；仅本机 HTTP 联调可设 false。
ADMIN_COOKIE_SECURE=true
# 历史教师 DATETIME 字段的 UTC 偏移；空值沿用后端运行环境偏移。
TEACHER_DATA_UTC_OFFSET=

# 学期报告：Compose 默认连接本地 Docling；仅替换解析器时覆盖 URL。
SEMESTER_REPORT_PARSER_URL=http://docling-parser:8000/parse
SEMESTER_REPORT_PARSER_API_KEY=
REPORT_AI_BASE_URL=
# auto: 无 AI 配置时使用本地模板；也可设 template 或 ai。
REPORT_GENERATION_MODE=auto
REPORT_AI_API_KEY=
REPORT_AI_MODEL=
REPORT_PUBLIC_BASE_URL=https://classroom.example.com
# 用 openssl rand -base64 32 生成；密钥要单独备份，不能提交到仓库。
REPORT_SHARE_ENCRYPTION_KEY=
