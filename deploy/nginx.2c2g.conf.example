# Host nginx configuration. Replace domains and certificate paths before enabling.
# Included from nginx's http context. Default ports must match .env.2c2g.
server {
    listen 80;
    server_name classroom.example.com admin.classroom.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name classroom.example.com;

    # 若前面还有 CDN/负载均衡，请只信任其固定地址并取消以下注释；不要写 0.0.0.0/0。
    # set_real_ip_from 10.0.0.10;
    # real_ip_header X-Forwarded-For;
    # real_ip_recursive on;
    ssl_certificate /etc/letsencrypt/live/classroom.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/classroom.example.com/privkey.pem;
    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 10s;
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
    }
}

server {
    listen 443 ssl;
    server_name admin.classroom.example.com;
    ssl_certificate /etc/letsencrypt/live/admin.classroom.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.classroom.example.com/privkey.pem;
    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 660s;
    }
}
